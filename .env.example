# ═══════════════════════════════════════════════════════════════════════════════
# SALES OS · variables de entorno
# ═══════════════════════════════════════════════════════════════════════════════
#
# Este fichero es la DOCUMENTACIÓN de las variables. Nunca lleva valores.
#
#   cp .env.example .env.local     ← .env.local está en .gitignore
#
# Dónde va cada cosa:
#
#   .env.local            Desarrollo en tu máquina. No se sube nunca.
#   Vercel                Variables de la aplicación, por entorno
#                         (Production / Preview / Development).
#   GitHub Environments   Solo lo que necesita CI (despliegue, E2E, remote cache).
#   Supabase Vault        Credenciales DE CADA TENANT (tokens OAuth de su
#                         Pipedrive, de sus buzones, de sus cuentas). Estas NUNCA
#                         son variables de entorno: se guardan cifradas por
#                         tenant y se leen en ejecución (F1.7).
#
# Regla: si una credencial pertenece a un corporate concreto, va a Vault. Si
# pertenece a la plataforma SALES OS, va a Vercel o a GitHub. Al repo, nada.
#
# La columna "Fase" dice cuándo se necesita de verdad. Lo que no es de F0 puede
# quedarse vacío sin romper nada: el sistema lo detecta y lo muestra como
# "no configurado" en /status.
# ═══════════════════════════════════════════════════════════════════════════════


# ─── Entorno y plataforma ─────────────────────────────────────── F0 ───────────
# dev | preview | staging | production
SALES_OS_ENV=
# URL pública de esta instalación (sin barra final)
NEXT_PUBLIC_APP_URL=
# Versión mostrada en la página de inicio. En Vercel se rellena sola desde el
# commit desplegado; solo hace falta en local.
NEXT_PUBLIC_APP_VERSION=


# ─── Modo sandbox · salvaguarda bloqueada ─────────────────────── F0.15 ───────
# on  → bloquea todo contacto saliente que no esté en la lista blanca
# off → SOLO válido en producción
# Si no se define, el sistema asume "on" (falla cerrado).
SANDBOX_MODE=
# Lista blanca separada por comas. Acepta direcciones de email (con alias +),
# teléfonos en E.164, URLs de perfil de LinkedIn y handles sociales.
# Ejemplo de formato: alex.ruiz+t1@turbineh.com,+34600000000,linkedin.com/in/...
SANDBOX_ALLOWLIST=
# Contraseña de acceso a la sala de pruebas /lab mientras no existe Supabase
# Auth (provisional de F0.16; se sustituye por rol admin en F1.3).
LAB_ACCESS_PASSWORD=


# ─── Supabase · base de datos, auth, storage y vault ─────────── F0.9 / F1 ────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Salta RLS. Solo en el servidor. Nunca en una variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# Conexión para Drizzle. POOLED para la aplicación, DIRECT para migraciones.
DATABASE_URL=
DATABASE_DIRECT_URL=


# ─── Inngest · orquestación de workflows durables ────────────── F0.10 ────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Entorno de Inngest (staging, production…)
INNGEST_ENV=


# ─── Modelos de lenguaje ─────────────────────────────────────── F2 ───────────
ANTHROPIC_API_KEY=
# Router de modelos por nivel de tarea (plan §2.6).
LLM_MODEL_LIGHT=
LLM_MODEL_MEDIUM=
LLM_MODEL_HEAVY=
# Presupuesto mensual por defecto de un tenant nuevo, en euros. Corte duro al
# 100 %, avisos al 50 % y al 80 %.
LLM_DEFAULT_MONTHLY_BUDGET_EUR=


# ─── Observabilidad ──────────────────────────────────────────── F0.11 ───────
# Langfuse (instancia de la UE)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Solo para subir source maps desde CI. Va en GitHub Environments, no en local.
SENTRY_AUTH_TOKEN=

# Better Stack (logs y alertas)
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGEST_URL=


# ─── CRM · Pipedrive ─────────────────────────────────────────── F4 ──────────
# App del Marketplace de Pipedrive. El token de CADA tenant va a Vault, no aquí.
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_REDIRECT_URI=
PIPEDRIVE_WEBHOOK_SECRET=


# ─── Correo ──────────────────────────────────────────────────── F7 ──────────
# Buzones de outreach: OAuth de Google Workspace y de Microsoft 365. El token de
# cada buzón de cada tenant va a Vault.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=
MICROSOFT_OAUTH_REDIRECT_URI=

# Email del sistema (notificaciones y transaccional). NO se usa para email en
# frío: los proveedores transaccionales no lo admiten (plan §2.2 y ADR 0001).
RESEND_API_KEY=
SYSTEM_EMAIL_FROM=
SYSTEM_EMAIL_REPLY_TO=


# ─── Voz ─────────────────────────────────────────────────────── F9 ──────────
# retell | vapi — decisión en ADR 0005
VOICE_PROVIDER=
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# Twilio para los números
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_SECRET=


# ─── WhatsApp Business Cloud API ─────────────────────────────── F4.8 ────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=


# ─── Agenda ──────────────────────────────────────────────────── F4.7 ────────
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_WEBHOOK_SIGNING_KEY=
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=


# ─── Pagos · Stripe ──────────────────────────────────────────── F10 ─────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Solo si el ADR 0006 decide Stripe Connect en vez de clave restringida por tenant
STRIPE_CONNECT_CLIENT_ID=


# ─── Firma electrónica ───────────────────────────────────────── F10.4 ───────
# docuseal | signaturit — decisión en ADR 0006
ESIGN_PROVIDER=
DOCUSEAL_BASE_URL=
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=
SIGNATURIT_API_KEY=
SIGNATURIT_WEBHOOK_SECRET=


# ─── Enriquecimiento y búsqueda ──────────────────────────────── F5 ──────────
HUNTER_API_KEY=
BRAVE_SEARCH_API_KEY=


# ─── Redes sociales · Generador de Opinión ───────────────────── F12 ─────────
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=


# ─── Notificaciones humanas ──────────────────────────────────── F4.8 ────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=


# ─── GitHub · exportar mejoras y escalado del Copiloto ───────── F2B ────────
# App de GitHub con permiso para abrir PR e issues en este repositorio.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_TARGET_REPO=


# ─── Workers de navegador (Hetzner) ──────────────────────────── F8 / F14 ───
# Secreto compartido entre el plano de control y los workers.
WORKER_SHARED_SECRET=
WORKER_BASE_URL=
# Un perfil de navegador por cuenta, cifrado en reposo.
CHROME_PROFILES_DIR=
# Proxy ISP con IP estática por cuenta de LinkedIn.
PROXY_URL_TEMPLATE=
PROXY_USERNAME=
PROXY_PASSWORD=


# ─── Sistema de facturación heredado (envuelto, ADR 0001) ────── F10.9 ──────
# El sistema actual sigue facturando. SALES OS le habla por HTTP; no se apaga
# hasta que F14 esté validado.
LEGACY_BILLING_BASE_URL=
LEGACY_BILLING_TOKEN=


# ─── Solo CI (GitHub Environments, no en local) ──────────────── F0.6 ───────
# Remote cache de Turborepo. Sin esto, CI usa solo la caché local.
TURBO_TOKEN=
TURBO_TEAM=
# URL contra la que corren los E2E de fase.
E2E_BASE_URL=
E2E_LAB_PASSWORD=
