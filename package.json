{
  "name": "sales-os",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma de ventas ag\u00e9ntica multi-corporate. Nace vac\u00eda: ning\u00fan dato de negocio en el c\u00f3digo",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm sistema-vacio && pnpm variables-publicas && pnpm audit --audit-level high",
    "verify:rapido": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm sistema-vacio && pnpm variables-publicas",
    "e2e": "turbo run e2e",
    "e2e:staging": "node scripts/e2e-staging.mjs",
    "sistema-vacio": "node scripts/src/sistema-vacio-cli.ts",
    "variables-publicas": "node scripts/src/variables-publicas-cli.ts",
    "db:migrar": "pnpm --filter @sales-os/db db:migrar",
    "eventos:reproceso": "pnpm --filter @sales-os/db eventos:reproceso",
    "verify:bundle": "node scripts/src/variables-publicas-cli.ts --bundle apps/web/.next/static",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "catalog:",
    "typescript-eslint": "8.70.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
